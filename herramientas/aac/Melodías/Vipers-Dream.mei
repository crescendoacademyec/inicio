                        <harm xml:id="r1lcxba4" staff="1" tstamp="1">F</harm>
                        <harm xml:id="t16lz6xi" staff="1" tstamp="3">G7</harm>
                     </measure>
                  </section>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>